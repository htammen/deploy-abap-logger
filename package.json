{
  "name": "@htammen/deploy-abap-logger",
  "version": "0.1.0",
  "description": "pkg that logs deployment of ui5 apps to abap repository (BSP)",
  "main": "index.mjs",
  "bin": {
    "deploy-abap-logger": "index.mjs"
  },
  "scripts": {
    "build": "npm-run-all clean ts:compile",
    "ts:compile": "tsc",
    "clean": "rimraf dist",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:gitcommit": "deno run --unstable-sloppy-imports --allow-env --allow-read --allow-run test/testGitCommitHandler.ts"
  },
  "keywords": [
    "deploy",
    "abap",
    "log"
  ],
  "author": "Helmut Tammen",
  "license": "MIT",
  "dependencies": {
    "fs-extra": "^11.2.0",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/fs-extra": "^11.0.4",
    "globals": "^16.0.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.26.1"
  }
}
